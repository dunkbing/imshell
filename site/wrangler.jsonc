// cloudflare workers static assets, like dearsql.dev, built by cloudflare from the repo (root
// site/, bun run build). the gallery wasm is committed in public/gallery: refresh it with build.sh
{
  "name": "mydear",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
