---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div data-doc-search data-src={`${base}/docs/search.json`} data-base={`${base}/docs`} class="relative">
  <input type="search" placeholder="search the docs" aria-label="search the docs" autocomplete="off"
    class="w-full bg-surface0 border border-surface1 text-text px-2 py-1 text-xs" />
  <ul class="hidden mt-2 space-y-2 text-xs"></ul>
</div>

<script>
  type Entry = { page: string; title: string; heading: string; anchor: string; text: string };
  let index: Promise<Entry[]> | undefined;

  const run = (terms: string[], all: Entry[]) =>
    all
      .map((e) => {
        const head = `${e.title} ${e.heading}`.toLowerCase();
        const body = e.text.toLowerCase();
        let matched = 0;
        let score = 0;
        for (const t of terms) {
          const inHead = head.includes(t);
          const inBody = body.split(t).length - 1;
          if (inHead || inBody) matched++;
          score += (inHead ? 5 : 0) + Math.min(inBody, 5);
        }
        return { e, matched, score };
      })
      .filter((r) => r.matched > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 8);

  const snippet = (text: string, terms: string[]) => {
    const lower = text.toLowerCase();
    const at = Math.min(...terms.map((t) => lower.indexOf(t)).filter((i) => i >= 0), text.length);
    const start = Math.max(0, at - 40);
    return (start ? "..." : "") + text.slice(start, start + 140) + (start + 140 < text.length ? "..." : "");
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-doc-search]")) {
    const input = root.querySelector("input")!;
    const list = root.querySelector("ul")!;
    input.addEventListener("input", async () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      list.replaceChildren();
      list.classList.toggle("hidden", terms.length === 0);
      if (!terms.length) return;
      index ??= fetch(root.dataset.src!).then((r) => r.json());
      const found = run(terms, await index);
      if (input.value.toLowerCase().split(/\s+/).filter(Boolean).join(" ") !== terms.join(" ")) return; // typed on
      for (const { e } of found) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `${root.dataset.base}/${e.page}${e.anchor ? `#${e.anchor}` : ""}`;
        a.className = "font-bold text-text underline";
        a.textContent = e.heading ? `${e.title} > ${e.heading}` : e.title;
        const p = document.createElement("p");
        p.className = "text-subtext0";
        p.textContent = snippet(e.text, terms);
        li.append(a, p);
        list.append(li);
      }
      if (!found.length) {
        const li = document.createElement("li");
        li.className = "text-subtext0";
        li.textContent = "nothing found";
        list.append(li);
      }
    });
    input.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape") {
        input.value = "";
        input.dispatchEvent(new Event("input"));
      }
    });
  }
</script>
