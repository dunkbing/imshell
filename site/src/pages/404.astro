---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Not found · mydear">
  <main class="max-w-2xl mx-auto px-4 py-6 text-sm">
    <h1 class="text-xl font-bold mb-2">## 404</h1>
    <p class="text-subtext0">No page here. Try the <a href={`${base}/`}>home page</a> or the <a href={`${base}/docs`}>docs</a>.</p>
  </main>
</Layout>
